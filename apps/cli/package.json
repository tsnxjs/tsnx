{
  "name": "@tsnx/cli",
  "version": "1.0.0-rc.1",
  "description": "TSNX CLI - Developer interface for TypeScript projects and workspaces",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tsnx": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --noEmit",
    "test": "node ../../scripts/test-runner.js"
  },
  "dependencies": {
    "@tsnx/build": "workspace:*",
    "@tsnx/core": "workspace:*",
    "yaml": "^2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tsnx/tsnx.git",
    "directory": "apps/cli"
  },
  "bugs": "https://github.com/tsnx/tsnx/issues",
  "homepage": "https://github.com/tsnx/tsnx#readme"
}
